<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Расписание: создание / редактирование правила + предпросмотр «сегодня/завтра» -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.desktop.controller.ScheduleController"
      styleClass="screen"
      spacing="14">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="←" onAction="#onBack" styleClass="ghost-button"/>
        <Label text="Расписание" styleClass="screen-title"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- ================== СЛЕВА: форма правила ================== -->
        <VBox styleClass="card" prefWidth="430" spacing="8">
            <Label text="Правило расписания" styleClass="section-title"/>

            <Label text="Название" styleClass="caption"/>
            <TextField fx:id="nameField" promptText="Например: база A/B/C"/>

            <Label text="Дата старта" styleClass="caption"/>
            <DatePicker fx:id="startDateField" maxWidth="Infinity"/>

            <Label text="Интервал, дней" styleClass="caption"/>
            <Spinner fx:id="intervalSpinner" editable="true" maxWidth="Infinity"/>

            <Label text="Шаблоны по порядку: 1 = A, 2 = B, 3 = C" styleClass="caption"/>
            <ListView fx:id="planList" prefHeight="210" VBox.vgrow="ALWAYS"/>

            <Label text="Начинать с тренировки" styleClass="caption"/>
            <ComboBox fx:id="startPlanBox" maxWidth="Infinity" promptText="первый в списке"/>

            <!-- режим: создание / редактирование -->
            <Label fx:id="statusLabel" styleClass="muted" wrapText="true"/>

            <Button fx:id="saveButton"
                    text="Создать"
                    onAction="#onSave"
                    styleClass="primary-button"
                    maxWidth="Infinity"/>

            <!-- активна только в режиме редактирования -->
            <Button fx:id="cancelButton"
                    text="Отмена"
                    onAction="#onCancel"
                    styleClass="small-button"
                    maxWidth="Infinity"
                    disable="true"/>
        </VBox>

        <!-- ============= СПРАВА: ближайшие тренировки + список ============= -->
        <VBox spacing="12" HBox.hgrow="ALWAYS">

            <VBox styleClass="card" spacing="6">
                <Label text="Ближайшие тренировки" styleClass="section-title"/>
                <Label fx:id="todayLabel" text="Сегодня: —"/>
                <Label fx:id="nextLabel" text="Следующая: —"/>
                <Label text="Тренировка бывает только в дни, кратные интервалу; остальные дни — отдых."
                       styleClass="muted" wrapText="true"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Мои расписания" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="editButton"
                        text="Редактировать"
                        onAction="#onEdit"
                        styleClass="small-button"
                        disable="true"/>
                <Button fx:id="deleteButton"
                        text="Удалить"
                        onAction="#onDelete"
                        styleClass="small-button"
                        disable="true"/>
            </HBox>

            <ListView fx:id="scheduleList" VBox.vgrow="ALWAYS"/>

            <Label text="Клик по правилу в списке сразу подставляет его в форму слева."
                   styleClass="caption"/>
        </VBox>
    </HBox>
</VBox>
