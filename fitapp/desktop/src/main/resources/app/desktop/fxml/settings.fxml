<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Настройки: тема, акцент, шрифт, звук, бэкап и экспорт -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.desktop.controller.SettingsController"
      styleClass="screen"
      spacing="14">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="←" onAction="#onBack" styleClass="ghost-button"/>
        <Label text="Настройки" styleClass="screen-title"/>
    </HBox>

    <VBox styleClass="card" spacing="10" maxWidth="560">
        <Label text="Оформление" styleClass="section-title"/>

        <Label text="Тема" styleClass="caption"/>
        <ComboBox fx:id="themeBox" maxWidth="Infinity"/>

        <Label text="Акцентный цвет" styleClass="caption"/>
        <ColorPicker fx:id="accentPicker" maxWidth="Infinity"/>

        <Label text="Размер шрифта, px" styleClass="caption"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Spinner fx:id="fontSizeSpinner" prefWidth="120" editable="true"/>
            <Label text="12–24, по умолчанию 13" styleClass="muted"/>
        </HBox>

        <Label fx:id="previewLabel" styleClass="muted" wrapText="true"/>

        <Button text="Сохранить" onAction="#onSave" styleClass="primary-button" maxWidth="Infinity"/>
    </VBox>

    <VBox styleClass="card" spacing="10" maxWidth="560">
        <Label text="Звук таймера отдыха" styleClass="section-title"/>
        <Label text="Короткий сигнал, когда обратный отсчёт дошёл до нуля. Без файла — системный beep."
               styleClass="muted" wrapText="true"/>

        <Label text="Текущий звук" styleClass="caption"/>
        <Label fx:id="soundLabel" text="системный сигнал (beep)" wrapText="true"/>

        <HBox spacing="10">
            <Button text="Выбрать звук" onAction="#onPickSound" styleClass="small-button"/>
            <Button text="Без звука" onAction="#onClearSound" styleClass="small-button"/>
        </HBox>
    </VBox>

    <VBox styleClass="card" spacing="10" maxWidth="560">
        <Label text="Данные" styleClass="section-title"/>
        <Label text="Всё хранится локально в PostgreSQL. Бэкап — JSON, экспорт — Excel."
               styleClass="muted" wrapText="true"/>

        <HBox spacing="10">
            <Button text="Бэкап (JSON)" onAction="#onBackup"/>
            <Button text="Экспорт (Excel)" onAction="#onExportExcel"/>
        </HBox>

        <Label text="Восстановление заменяет все данные из файла. Пользователь и настройки остаются."
               styleClass="caption" wrapText="true"/>
        <HBox spacing="10">
            <Button text="Импорт JSON (Восстановление)" onAction="#onImport" styleClass="small-button"/>
        </HBox>
    </VBox>
</VBox>
