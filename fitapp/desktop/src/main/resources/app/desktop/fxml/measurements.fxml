<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Измерения: таблица и форма — на первой вкладке, график — на второй -->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.desktop.controller.MeasurementsController"
      styleClass="screen"
      spacing="14">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="←" onAction="#onBack" styleClass="ghost-button"/>
        <Label text="Измерения" styleClass="screen-title"/>
    </HBox>

    <TabPane fx:id="measurementsTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ===================== ВКЛАДКА 1: замеры ===================== -->
        <Tab text="Замеры">
            <HBox spacing="16">

                <!-- ================== СЛЕВА: форма замера ================== -->
                <VBox styleClass="card" prefWidth="340" spacing="8">
                    <Label text="Новый замер" styleClass="section-title"/>

                    <Label text="Тип" styleClass="caption"/>
                    <ComboBox fx:id="kindBox" maxWidth="Infinity"/>

                    <Label text="Название" styleClass="caption"/>
                    <TextField fx:id="nameField" promptText="наклон вперёд"/>

                    <Label text="Значение" styleClass="caption"/>
                    <TextField fx:id="valueField" promptText="12.5"/>

                    <Label text="Единица" styleClass="caption"/>
                    <TextField fx:id="unitField" promptText="см / кг / уд/мин"/>

                    <Label text="Заметка" styleClass="caption"/>
                    <TextArea fx:id="noteArea" prefRowCount="3" wrapText="true"/>

                    <!-- картинка к замеру -->
                    <Label text="Картинка" styleClass="caption"/>
                    <HBox spacing="8">
                        <Button text="Прикрепить" onAction="#onPickImage" styleClass="small-button"/>
                        <Button text="Убрать" onAction="#onClearImage" styleClass="small-button"/>
                    </HBox>
                    <ImageView fx:id="previewImage" fitWidth="100" fitHeight="100" preserveRatio="true"/>
                    <Label fx:id="imageNameLabel"
                           text="картинка не выбрана"
                           styleClass="muted"
                           wrapText="true"/>

                    <Button text="Добавить замер"
                            onAction="#onAdd"
                            styleClass="primary-button"
                            maxWidth="Infinity"/>
                    <Button text="Удалить выбранный"
                            onAction="#onDelete"
                            styleClass="small-button"
                            maxWidth="Infinity"/>
                </VBox>

                <!-- ================== СПРАВА: таблица ================== -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <TableView fx:id="table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colDate" text="Дата" prefWidth="150"/>
                            <TableColumn fx:id="colKind" text="Тип" prefWidth="140"/>
                            <TableColumn fx:id="colValue" text="Значение" prefWidth="120"/>
                            <TableColumn fx:id="colNote" text="Заметка" prefWidth="240"/>
                            <TableColumn fx:id="colPhoto" text="Фото" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <Label text="Клик по слову «фото» (или двойной клик по строке) открывает картинку в отдельном окне."
                           styleClass="caption"/>
                    <Label text="Значение можно не заполнять — например, если замер только на фото."
                           styleClass="caption"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- ===================== ВКЛАДКА 2: график ===================== -->
        <Tab text="График">
            <VBox spacing="10">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Показатель" styleClass="caption"/>
                    <ComboBox fx:id="chartTypeBox" prefWidth="180"/>

                    <Label text="с" styleClass="caption"/>
                    <DatePicker fx:id="chartFromPicker" prefWidth="150"/>

                    <Label text="по" styleClass="caption"/>
                    <DatePicker fx:id="chartToPicker" prefWidth="150"/>

                    <Button fx:id="buildChartButton"
                            text="Построить график"
                            onAction="#onBuildChart"
                            styleClass="primary-button"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="chartInfoLabel" styleClass="muted"/>
                </HBox>

                <LineChart fx:id="measurementChart"
                           legendVisible="false"
                           animated="false"
                           createSymbols="true"
                           VBox.vgrow="ALWAYS">
                    <xAxis>
                        <NumberAxis fx:id="chartXAxis" label="Дата" forceZeroInRange="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="chartYAxis" label="Значение" forceZeroInRange="false"/>
                    </yAxis>
                </LineChart>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
